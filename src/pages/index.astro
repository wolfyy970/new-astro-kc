---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import EditionNote from "../components/EditionNote.astro";
import SmilePortrait from "../components/SmilePortrait.astro";
import resumeRaw from "../content/resume.json";
import popoversRaw from "../content/popovers.json";
import { popoverMapSchema, resumeSchema } from "../content/schema";
import { createHotspotRenderer } from "../utils/render";
import "../styles/global.css";

import { optimizePopoverImages } from "../utils/images";
import { applyFeatureFlags } from "../utils/feature-flags";
import { dateRangeLines } from "../utils/dates";

// ── Image Optimization + Feature Flags ───────────────────────────────────────
// 1. Ask Astro's image service for fitted WebP URLs before popover data is
//    serialized to the client, retaining the output dimensions.
// 2. Strip case study links whose slug is not in CASE_STUDY_LINKS env var,
//    so the client never receives links to unpublished pages.

const resume = resumeSchema.parse(resumeRaw);
const popovers = applyFeatureFlags(
  await optimizePopoverImages(popoverMapSchema.parse(popoversRaw), getImage),
);

// ── Annotation markers ───────────────────────────────────────────────────────
// The feature-flagged map adds a superscript marker only when a deeper case
// study is actually available in the current environment.
const mark = createHotspotRenderer(popovers);

const summaryParagraphs = resume.summary.split("\n\n");
---

<BaseLayout
  title={resume.displayName}
  description="Design leadership by KC Wolff-Ingham. Senior product design leader with 30 years spanning banking, health tech, and media."
>
  <!-- ═══════ MASTHEAD — the cover ═══════ -->
  <!-- Full-bleed ink field; the document emerges on light stock below it. -->
  <header class="masthead">
    <div class="masthead-inner">
      <!-- The head is a two-column grid: name and rule in the text column,
           the author's portrait in its own column opposite — which is what
           curtails the rule. It stops where the figure's column begins. -->
      <div class="masthead-head">
        <h1 class="masthead-name">{resume.displayName}</h1>
        <SmilePortrait />
        <div class="masthead-rule"></div>
      </div>

      <!-- Everything the reader needs to place this person lives here, once.
         There is no second identity block on the sheet below: the résumé opens
         straight into the prose. -->
      <div class="masthead-meta">
        <div class="masthead-lede">
          <p class="masthead-role">{resume.titleLine}</p>
          <p class="masthead-sub">{resume.hero.tagline}</p>
        </div>
        <ul class="masthead-credentials" aria-label="Credentials">
          {
            resume.hero.credentials.map((credential) => (
              <li class="masthead-cred">{credential}</li>
            ))
          }
        </ul>
      </div>

      <div class="masthead-contact">
        <a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
        <span class="masthead-sep" aria-hidden="true">·</span>
        <span>{resume.contact.phone}</span>
        <span class="masthead-sep" aria-hidden="true">·</span>
        <a
          href={resume.contact.linkedinUrl}
          target="_blank"
          rel="noopener noreferrer"
          >{resume.contact.linkedin}<span class="sr-only">
            {" "}(opens in new tab)</span
          ></a
        >
        <span class="masthead-sep" aria-hidden="true">·</span>
        <span>{resume.contact.location}</span>
      </div>
    </div>
  </header>

  <!-- ═══════ THE DOCUMENT ═══════ -->
  <main class="doc-wrapper" id="main-content">
    <article class="doc-page reveal" aria-label="Resume Content">
      <!-- No identity block. The masthead above states who this is, what they
           do, what they hold and how to reach them — once. Below the wide
           tier the sheet opens with the editor's note — the introduction as
           a piece of the document, not chrome above it — then straight into
           the prose. At the wide tier the margin performs the introduction
           and the note does not render its box at all. -->
      <EditionNote />

      <!-- Executive Summary -->
      {
        summaryParagraphs.map((para) => (
          <p class="doc-summary" set:html={mark(para)} />
        ))
      }

      <!-- Experience -->
      <h2 class="doc-section-heading">Experience</h2>

      {
        resume.experience.map((job) => {
          const range = dateRangeLines(job.dates);
          return (
            <section class="doc-exp">
              {/* The time axis. Years run down one edge of the document, so
                tenure and sequence are readable without parsing a sentence.
                This was a company-left/dates-right row — the most generic
                pattern the résumé form has. The rail hangs in the sheet's own
                margin (see --sheet-inset) so the prose keeps one left edge. */}
              <span class="doc-exp-years" aria-hidden="true">
                <span class="date-range">
                  <span class="date-range-start">{range.start}</span>
                  {range.end && <span class="date-range-end">{range.end}</span>}
                </span>
              </span>
              <div class="doc-exp-body">
                <h3 class="doc-exp-company">
                  {job.company}
                  <span class="sr-only">, {job.dates}</span>
                </h3>
                <div class="doc-exp-title">{job.title}</div>
                {job.description && (
                  <div class="doc-exp-desc" set:html={mark(job.description)} />
                )}
                <ul>
                  {job.bullets.map((bullet) => (
                    <li set:html={mark(bullet)} />
                  ))}
                </ul>
              </div>
            </section>
          );
        })
      }

      <!-- Education -->
      <h2 class="doc-section-heading">Education</h2>

      {
        resume.education.map((edu) => (
          <section class="doc-edu-item">
            <h3 class="degree">{edu.degree}</h3>
            <div class="school">{edu.school}</div>
            {edu.focus && <div class="focus" set:html={mark(edu.focus)} />}
          </section>
        ))
      }

      <!-- Patents & Recognition -->
      <h2 class="doc-section-heading">Patents &amp; Recognition</h2>
      <div class="doc-awards-line">
        <strong>Patents:</strong>
        {resume.patentsAndRecognition.patents}
      </div>
      <div class="doc-awards-line">
        <strong>Awards:</strong>
        {resume.patentsAndRecognition.awards}
      </div>
      <div class="doc-awards-line">
        <strong>Certifications:</strong>
        {resume.patentsAndRecognition.certifications}
      </div>

      <!-- No running colophon. In print a running foot exists because pages get
           separated from each other; on one continuous sheet it was reprinting
           the name and the entire contact line a second time, three screens
           after the first. The record band above is the single source. -->
    </article>
  </main>

  <!-- ═══════ POPOVER OVERLAY ═══════ -->
  <div class="popover-overlay" id="popover-overlay" role="presentation"></div>
  <div
    class="popover"
    id="popover"
    role="dialog"
    aria-modal="true"
    aria-label="Details"
    tabindex="-1"
  >
  </div>

  <footer class="site-footer">
    <p>&copy; 2026 {resume.displayName}</p>
  </footer>

  <!-- ═══════ PAGE DATA → window globals ═══════ -->
  <!-- define:vars safely serialises build-time data; no template literals used here -->
  <script is:inline define:vars={{ popovers }}>
    window.__POPOVERS__ = popovers;
  </script>

  <!-- ═══════ CLIENT-SIDE JS (module) ═══════ -->
  <script>
    import "../scripts/main.ts";
  </script>
</BaseLayout>
