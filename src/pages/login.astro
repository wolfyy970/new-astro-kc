---
import "../styles/tokens.css";
import "../styles/controls.css";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggleButton from "../components/ThemeToggleButton.astro";
import HeadFonts from "../components/HeadFonts.astro";
import Icon from "../components/Icon.astro";
import { SESSION_COOKIE_NAME } from "../utils/auth.ts";

const password = process.env.SITE_PASSWORD || import.meta.env.SITE_PASSWORD;
let error = false;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const input = formData.get("password");

  if (input === password) {
    Astro.cookies.set(SESSION_COOKIE_NAME, password as string, {
      path: "/",
      httpOnly: true,
      secure: true,
      sameSite: "strict",
      maxAge: 60 * 60 * 24 * 7, // 1 week
    });
    return Astro.redirect("/");
  } else {
    error = true;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Confidential: KC Wolff-Ingham</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.png" />
    <HeadFonts />
    <ThemeScript />
    <style>
      /* Brand palette + fonts come from tokens.css (shared with
               global.css). This page defines no colour tokens of its own.

               It used to define four: a rust --accent-hover (#8f2d16) with a
               salmon night variant (#ef7d60), plus three rgba() tints of a
               blue-black (20, 19, 26). Two hues that identified nothing, and
               three text colours dimmed by alpha rather than stated as values.
               The shared ink/rule/light tokens cover every one of them. */

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* min-height, not height, and no overflow: hidden. The gate is one
               screen tall by intent, but a fixed 100vh with hidden overflow
               silently clips the form on a short window — and the title now
               scales with the viewport, so there is more to clip. */
      body {
        font-family: var(--doc-sans);
        background: var(--bg);
        color: var(--doc-heading);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .login-container {
        width: 100%;
        padding: 40px 32px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        opacity: 0;
        transform: translateY(16px);
        animation: reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
      }

      @keyframes reveal {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* The display role, the same one the masthead uses. The gate shows
               the reader the title of the document they are about to open, so
               it should be that title — at 44px fixed it was neither the
               display size nor any other step, and `nowrap` on the name put it
               over the edge of a 375px phone. */
      .logo {
        font-family: var(--display);
        font-size: var(--type-editorial);
        font-weight: 200;
        font-variation-settings: "opsz" 72;
        letter-spacing: -0.022em;
        line-height: 1.02;
        color: var(--doc-heading);
        margin-bottom: 14px;
      }

      .logo-name {
        display: block;
        white-space: nowrap;
      }

      /* The label role. It was sans at 0.28em — the one apparatus line on
               the page, set in a voice the apparatus never uses. */
      .logo-subtitle {
        display: block;
        font-family: var(--mono);
        font-size: var(--type-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--type-label-spacing-wide);
        margin-top: 14px;
        color: var(--doc-light);
      }

      .divider {
        width: 24px;
        height: 1px;
        background: var(--accent);
        margin: 28px auto 32px;
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        width: 100%;
        max-width: 360px;
      }

      .password-label {
        display: block;
        margin-bottom: 8px;
        color: var(--doc-light);
        font-family: var(--mono);
        font-size: var(--type-meta);
        letter-spacing: var(--type-label-spacing);
        text-align: left;
        text-transform: uppercase;
      }

      .password-control {
        position: relative;
      }

      /* 17px, not 15px. iOS Safari zooms the viewport whenever a focused
               input is set below 16px, so the gate was scaling itself on every
               phone the moment the reader tapped the field. 17px is also the
               body step, so the number is not a new one. */
      input {
        width: 100%;
        padding: 13px 44px;
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--doc-rule);
        font-family: var(--doc-sans);
        font-size: var(--type-body);
        text-align: center;
        outline: none;
        transition: border-color 0.25s ease;
        color: var(--doc-heading);
      }

      input:focus {
        border-bottom-color: var(--accent);
      }

      input[aria-invalid="true"] {
        border-bottom: 2px solid var(--doc-heading);
      }

      .password-toggle {
        position: absolute;
        right: 0;
        bottom: 0;
        display: inline-flex;
        width: 44px;
        height: 44px;
        align-items: center;
        justify-content: center;
        margin: 0;
        padding: 0;
        background: transparent;
        color: var(--doc-light);
        border: none;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      .password-toggle:hover,
      .password-toggle:focus-visible {
        background: transparent;
        color: var(--doc-heading);
      }

      .password-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .password-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .password-icon--visible {
        display: none;
      }

      .password-toggle[data-visible="true"] .password-icon--hidden {
        display: none;
      }

      .password-toggle[data-visible="true"] .password-icon--visible {
        display: inline-flex;
      }

      input::placeholder {
        color: var(--doc-light);
        font-style: italic;
        opacity: 1;
      }

      /* `color: white` was a literal, and --accent is #000 in the day
               edition but #ffffff at night — so the night gate rendered a white
               label on a white button at 1:1 and the only control on the page
               was invisible. --bg is the page's own stock, which inverts with
               the edition and is by definition the maximum contrast against
               the ink filling the button. */
      .submit-button {
        align-self: center;
        background: var(--accent);
        color: var(--bg);
        border: 1px solid var(--accent);
        border-radius: 2px;
        padding: 11px 40px;
        /* The only control on the page, and it measured 39px tall from
                   its padding alone. Stated rather than inferred from font
                   metrics, so it holds at any label length. */
        min-height: 44px;
        font-family: var(--mono);
        font-size: var(--type-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--type-label-spacing);
        cursor: pointer;
        transition:
          background 0.25s ease,
          color 0.25s ease;
        margin-top: 8px;
      }

      /* Inverts rather than shifting hue. The old hover went to a rust
               (#8f2d16) that belonged to no palette, and dimmed with opacity. */
      .submit-button:hover,
      .submit-button:focus-visible {
        background: var(--bg);
        color: var(--doc-heading);
      }

      .submit-button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* The failed attempt stays close to the field, like an editorial
               margin note: visible enough to catch, quiet enough not to turn a
               small mistake into a rejection state. */
      .error-msg {
        width: 100%;
        margin: 0;
        padding: 0 0 0 12px;
        border-left: 1px solid var(--doc-rule);
        color: var(--doc-body);
        font-family: var(--doc-sans);
        font-size: var(--type-body-sm);
        font-weight: 400;
        line-height: 1.4;
        text-align: left;
      }
    </style>
  </head>
  <body>
    <ThemeToggleButton />
    <div class="login-container">
      <div class="logo">
        <span class="logo-name">KC Wolff-Ingham</span>
        <span class="logo-subtitle">Resume and Selected Work</span>
      </div>

      <div class="divider"></div>

      <form method="POST">
        <div class="password-control">
          <label class="password-label" for="password">Password</label>
          <input
            id="password"
            type="password"
            name="password"
            placeholder="Enter password"
            required
            autofocus
            autocomplete="current-password"
            autocapitalize="off"
            spellcheck="false"
            aria-invalid={error ? "true" : "false"}
            aria-describedby={error ? "password-error" : undefined}
          />
          <button
            class="password-toggle"
            type="button"
            aria-controls="password"
            aria-label="Show password"
            aria-pressed="false"
            data-visible="false"
          >
            <span class="password-icon password-icon--hidden">
              <Icon name="eye-off" size={20} />
            </span>
            <span class="password-icon password-icon--visible">
              <Icon name="eye" size={20} />
            </span>
          </button>
        </div>
        {
          error && (
            <p id="password-error" class="error-msg" role="alert">
              That didn’t match. Please try again.
            </p>
          )
        }
        <button class="submit-button" type="submit">Unlock Access</button>
      </form>
    </div>

    <script>
      import { initPasswordVisibilityToggle } from "../scripts/password-visibility.ts";

      initPasswordVisibilityToggle();
    </script>
  </body>
</html>
