---
import "../styles/tokens.css";
import "../styles/controls.css";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggleButton from "../components/ThemeToggleButton.astro";
import HeadFonts from "../components/HeadFonts.astro";
import Icon from "../components/Icon.astro";
import {
  readSitePassword,
  safeEqual,
  SESSION_COOKIE_NAME,
} from "../utils/auth.ts";

const password = readSitePassword();
let error = false;

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const input = formData.get("password");

  if (typeof input === "string" && password && safeEqual(input, password)) {
    Astro.cookies.set(SESSION_COOKIE_NAME, password as string, {
      path: "/",
      httpOnly: true,
      secure: true,
      sameSite: "strict",
      maxAge: 60 * 60 * 24 * 7, // 1 week
    });
    return Astro.redirect("/");
  } else {
    error = true;
  }
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KC Wolff-Ingham</title>
    <meta name="robots" content="noindex, nofollow" />
    <HeadFonts />
    <ThemeScript />
    <style>
      /* Brand palette + fonts come from tokens.css (shared with
               global.css). This page defines no colour tokens of its own.

               It used to define four: a rust --accent-hover (#8f2d16) with a
               salmon night variant (#ef7d60), plus three rgba() tints of a
               blue-black (20, 19, 26). Two hues that identified nothing, and
               three text colours dimmed by alpha rather than stated as values.
               The shared ink/rule/light tokens cover every one of them. */

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* min-height, not height, and no overflow: hidden. The gate is one
               screen tall by intent, but a fixed 100vh with hidden overflow
               silently clips the form on a short window — and the title now
               scales with the viewport, so there is more to clip.
               Optical centering lifts the stack slightly above mathematical midpoint. */
      body {
        font-family: var(--doc-sans);
        background: var(--bg);
        color: var(--doc-heading);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding-bottom: clamp(24px, 6vh, 64px);
      }

      .login-container {
        width: 100%;
        padding: 40px 32px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Visible by default. A document that has to be read does not put
               its content behind a keyframe — the résumé masthead already
               animates FROM a readable default; the gate used to start at
               opacity 0 and only exist if the animation ran. */
      @media (prefers-reduced-motion: no-preference) {
        .login-container {
          animation: reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) backwards;
        }
      }

      @keyframes reveal {
        from {
          opacity: 0;
          transform: translateY(16px);
        }
      }

      .login-sheet {
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: max-content;
        max-width: 100%;
        min-width: 0;
      }

      /* The display role, the same one the masthead uses. The gate shows
               the reader the title of the document they are about to open, so
               it should be that title — at 44px fixed it was neither the
               display size nor any other step, and `nowrap` on the name put it
               over the edge of a 375px phone. */
      .logo {
        display: block;
      }

      .logo-name {
        display: block;
        font-family: var(--display);
        font-size: var(--type-editorial);
        font-weight: 200;
        font-variation-settings: "opsz" 72;
        letter-spacing: -0.022em;
        line-height: 1.02;
        color: var(--doc-heading);
      }

      /* The label role. It was sans at 0.28em — the one apparatus line on
               the page, set in a voice the apparatus never uses. */
      .logo-subtitle {
        display: block;
        font-family: var(--mono);
        font-size: var(--type-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--type-label-spacing-wide);
        margin-top: 14px;
        color: var(--doc-light);
      }

      .divider {
        width: 100%;
        height: 1px;
        margin: 28px 0 40px;
        border: 0;
        background: var(--doc-heading);
      }

      form {
        display: flex;
        flex-direction: column;
        gap: 24px;
        width: 100%;
        align-self: stretch;
      }

      .password-label {
        display: block;
        margin: 0 0 8px;
        line-height: 1;
        color: var(--doc-light);
        font-family: var(--mono);
        font-size: var(--type-meta);
        letter-spacing: var(--type-label-spacing);
        text-align: left;
        text-transform: uppercase;
      }

      .password-control {
        display: flex;
        flex-direction: column;
        width: 100%;
      }

      /* The line is the field. 8px under the 22px type so the dots and
               the eye sit above the rule, not on it. */
      .password-field {
        position: relative;
        width: 100%;
        border-bottom: 1px solid var(--doc-rule);
        transition: border-color 0.25s ease;
      }

      .password-field:focus-within {
        border-bottom-color: var(--accent);
      }

      .password-control:has(input[aria-invalid="true"]) .password-field {
        border-bottom-color: var(--doc-heading);
      }

      input {
        display: block;
        box-sizing: content-box;
        width: 100%;
        height: 22px;
        padding: 0 44px 8px 0;
        background: transparent;
        border: none;
        font-family: var(--doc-sans);
        font-size: var(--type-body);
        line-height: 22px;
        text-align: left;
        outline: none;
        color: var(--doc-heading);
      }

      .password-toggle {
        position: absolute;
        right: 0;
        top: 0;
        display: inline-flex;
        width: 44px;
        height: 22px;
        align-items: center;
        justify-content: flex-end;
        margin: 0;
        padding: 0;
        background: transparent;
        color: var(--doc-light);
        border: none;
        cursor: pointer;
        transition: color 0.2s ease;
      }

      /* Expand the tap target without moving the glyph onto the rule. */
      .password-toggle::before {
        content: "";
        position: absolute;
        inset: -11px 0;
      }

      .password-toggle:hover,
      .password-toggle:focus-visible {
        background: transparent;
        color: var(--doc-heading);
      }

      .password-toggle:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
      }

      .password-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
      }

      .password-icon--visible {
        display: none;
      }

      .password-toggle[data-visible="true"] .password-icon--hidden {
        display: none;
      }

      .password-toggle[data-visible="true"] .password-icon--visible {
        display: inline-flex;
      }

      .submit-button {
        align-self: center;
        background: var(--accent);
        color: var(--bg);
        border: 1px solid var(--accent);
        border-radius: 2px;
        padding: 11px 40px;
        min-height: 44px;
        font-family: var(--mono);
        font-size: var(--type-meta);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: var(--type-label-spacing);
        cursor: pointer;
        transition:
          background 0.25s ease,
          color 0.25s ease;
        margin-top: 4px;
      }

      .submit-button:hover,
      .submit-button:focus-visible {
        background: var(--bg);
        color: var(--doc-heading);
      }

      .submit-button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .submit-button[aria-busy="true"] {
        cursor: wait;
      }

      /* Quiet situational notice when caps lock is active */
      .caps-warning {
        display: none;
        width: 100%;
        margin: -10px 0 0;
        padding: 0;
        color: var(--doc-light);
        font-family: var(--doc-sans);
        font-size: var(--type-body-sm);
        font-weight: 400;
        line-height: 1.4;
        text-align: left;
      }

      .caps-warning[data-active="true"] {
        display: block;
      }

      /* The failed attempt stays close to the field: quiet and flush-left,
               matching the caps warning notice. */
      .error-msg {
        width: 100%;
        margin: -10px 0 0;
        padding: 0;
        color: var(--doc-body);
        font-family: var(--doc-sans);
        font-size: var(--type-body-sm);
        font-weight: 400;
        line-height: 1.4;
        text-align: left;
      }
    </style>
  </head>
  <body>
    <ThemeToggleButton />
    <main class="login-container">
      <div class="login-sheet">
        <header class="logo">
          <h1 class="logo-name">KC Wolff-<wbr />Ingham</h1>
          <p class="logo-subtitle">Resume and Selected Work</p>
        </header>

        <hr class="divider" aria-hidden="true" />

        <form method="POST">
          <div class="password-control">
            <label class="password-label" for="password">Password</label>
            <div class="password-field">
              <input
                id="password"
                type="password"
                name="password"
                required
                autofocus
                autocomplete="current-password"
                autocapitalize="off"
                spellcheck="false"
                aria-invalid={error ? "true" : "false"}
                aria-describedby={error ? "password-error" : undefined}
              />
              <button
                class="password-toggle"
                type="button"
                aria-controls="password"
                aria-label="Show password"
                aria-pressed="false"
                data-visible="false"
              >
                <span class="password-icon password-icon--hidden">
                  <Icon name="eye-off" size={16} />
                </span>
                <span class="password-icon password-icon--visible">
                  <Icon name="eye" size={16} />
                </span>
              </button>
            </div>
          </div>
          <p
            id="caps-warning"
            class="caps-warning"
            role="status"
            aria-live="polite"
          >
            Caps Lock is on
          </p>
          {
            error && (
              <p id="password-error" class="error-msg" role="alert">
                That didn’t match. Please try again.
              </p>
            )
          }
          <button class="submit-button" type="submit">Continue</button>
        </form>
      </div>
    </main>

    <script>
      import { initPasswordVisibilityToggle } from "../scripts/password-visibility.ts";
      import { initCapsLockWarning } from "../scripts/caps-lock.ts";

      initPasswordVisibilityToggle();
      initCapsLockWarning();

      const form = document.querySelector("form");
      const submit = document.querySelector(".submit-button");
      form?.addEventListener("submit", (event) => {
        if (!(submit instanceof HTMLButtonElement)) return;
        // Do not disable the control here — some browsers abort the POST
        // when the clicked submit button is disabled in this handler.
        if (submit.dataset.opening === "true") {
          event.preventDefault();
          return;
        }
        submit.dataset.opening = "true";
        submit.setAttribute("aria-busy", "true");
      });
    </script>
  </body>
</html>
