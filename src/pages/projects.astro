---
import BaseLayout from "../layouts/BaseLayout.astro";
import projectsWritingRaw from "../content/projects-writing.json";
import { projectsWritingSchema } from "../content/schema";
import "../styles/work-index.css";

const content = projectsWritingSchema.parse(projectsWritingRaw);
const orgChart = content.projects.find((project) => project.state === "story");
const unreel = content.projects.find(
  (project) => project.state === "experiment",
);
const designer = content.projects.find(
  (project) => project.state === "published",
);

if (!orgChart || !unreel || !designer) {
  throw new Error(
    "Projects requires Org Chart Studio, Unreel Recipes, and Designer.",
  );
}
const orgChartHero = orgChart.story.hero;
if (!("image" in orgChartHero)) {
  throw new Error(
    "Org Chart Studio's project index entry requires an image hero.",
  );
}

const relatedWriting = designer.relatedWriting.map((slug) => {
  const entry = content.writing.find((item) => item.slug === slug);
  if (!entry) throw new Error(`Missing related writing entry: ${slug}`);
  return entry;
});

const formatDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  }).format(new Date(`${date}T12:00:00Z`));
---

<BaseLayout
  title="Projects & Writing — KC Wolff-Ingham"
  description="Independent projects and writing by design leader KC Wolff-Ingham."
  navSection="projects"
>
  <main class="work-index projects-index" id="main-content">
    <header class="work-index-header projects-index-header">
      <p class="work-index-kicker">Independent work</p>
      <h1 class="work-index-title projects-index-title">
        Projects <span>&amp; Writing</span>
      </h1>
      <p class="work-index-intro">
        Products, experiments, and essays about design leadership at the edge of
        what software can do.
      </p>
    </header>

    <nav class="projects-contents" aria-label="Project contents">
      <p class="projects-contents-label">On this page</p>
      <ol>
        <li><a href="#org-chart-studio"><span>01</span>Org Chart Studio</a></li>
        <li><a href="#unreel-recipes"><span>02</span>Unreel Recipes</a></li>
        <li><a href="#designer"><span>03</span>Designer</a></li>
      </ol>
    </nav>

    <section class="projects-section" aria-labelledby="projects-heading">
      <header class="projects-section-heading">
        <h2 id="projects-heading">Projects</h2>
      </header>

      <article class="project-entry project-entry--org" id="org-chart-studio">
        <header class="project-entry-header">
          <h3 class="project-entry-title project-entry-title--brand">
            <img
              class="project-brand-mark project-brand-mark--org"
              src={orgChart.brandMark}
              alt={orgChart.brandMarkAlt}
              width="52"
              height="52"
              decoding="async"
            />
            <span>Org Chart Studio</span>
          </h3>
          <p class="project-entry-meta">Independent product · 2026</p>
        </header>
        <div class="project-entry-lead">
          <div class="project-entry-copy">
            <p>{orgChartHero.subtitle}</p>
            <p>{orgChart.story.context.body}</p>
            <a class="project-story-link" href={orgChart.href}>
              Explore the case study <span aria-hidden="true">↗</span>
            </a>
          </div>
          <figure class="project-entry-media">
            <img
              src={orgChartHero.image}
              alt={orgChartHero.imageAlt}
              width="1600"
              height="1000"
              loading="lazy"
              decoding="async"
            />
            <figcaption>Sunny Peeps design system · Spectrum theme</figcaption>
          </figure>
        </div>
      </article>

      <article class="project-entry project-entry--unreel" id="unreel-recipes">
        <header class="project-entry-header">
          <h3 class="project-entry-title project-entry-title--wordmark">
            <span>Unreel Recipes</span>
          </h3>
          <p class="project-entry-meta">{unreel.eyebrow}</p>
        </header>
        <div class="project-entry-lead project-entry-lead--unreel">
          <div class="project-entry-copy">
            <p>{unreel.summary}</p>
            <p>{unreel.detail}</p>
            <a
              class="project-story-link"
              href={unreel.liveUrl}
              target="_blank"
              rel="noreferrer"
            >
              Visit Unreel Recipes <span aria-hidden="true">↗</span>
            </a>
          </div>
          <figure class="project-motion">
            <video
              controls
              playsinline
              muted
              preload="metadata"
              poster={unreel.stirringVideo.poster}
              width={unreel.stirringVideo.width}
              height={unreel.stirringVideo.height}
              aria-label={unreel.stirringVideo.label}
            >
              <source src={unreel.stirringVideo.src} type="video/mp4" />
            </video>
            <figcaption>
              The pot-stirring animation plays while a recipe is being built.
            </figcaption>
          </figure>
        </div>
        <div
          class="project-screenshots"
          role="group"
          aria-label="Unreel Recipes product screens"
        >
          {
            unreel.screenshots.map((screenshot) => (
              <figure>
                <img
                  src={screenshot.src}
                  alt={screenshot.alt}
                  width={screenshot.width}
                  height={screenshot.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{screenshot.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </article>

      <article
        class="project-feature project-entry project-entry--designer"
        id="designer"
      >
        <div class="project-feature-intro">
          <div>
            <h3>{designer.title}</h3>
            <p class="project-eyebrow project-feature-meta">
              {designer.eyebrow}
            </p>
          </div>
          <div class="project-feature-summary">
            <p>{designer.summary}</p>
            <a
              class="projects-text-link"
              href={designer.liveUrl}
              target="_blank"
              rel="noreferrer"
            >
              Open Designer <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <figure class="project-lead-media">
          <img
            src={designer.leadImage.src}
            alt={designer.leadImage.alt}
            width={designer.leadImage.width}
            height={designer.leadImage.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            From brief to differentiated hypotheses and working prototypes.
          </figcaption>
        </figure>

        <div class="project-feature-body">
          <div class="project-finding">
            <p class="project-eyebrow">What the experiment found</p>
            <p>{designer.detail}</p>
          </div>

          <figure class="project-demo">
            <video
              controls
              playsinline
              preload="metadata"
              poster={designer.video.poster}
              width={designer.video.width}
              height={designer.video.height}
              aria-label={designer.video.label}
            >
              <source src={designer.video.src} type="video/mp4" />
              <p>
                Your browser cannot play this video. <a
                  href="https://kcwolfy.substack.com/p/designer"
                  target="_blank"
                  rel="noreferrer">Watch the Designer demo on horizon.</a
                >
              </p>
            </video>
            <figcaption>Designer in use · 1:08</figcaption>
          </figure>
        </div>

        <div class="project-supporting">
          <img
            src={designer.supportingImage.src}
            alt={designer.supportingImage.alt}
            width={designer.supportingImage.width}
            height={designer.supportingImage.height}
            loading="lazy"
            decoding="async"
          />
        </div>

        <aside
          class="project-related"
          aria-labelledby="designer-reading-heading"
        >
          <p class="project-eyebrow" id="designer-reading-heading">
            The experiment, in writing
          </p>
          <ol>
            {
              relatedWriting.map((entry, index) => (
                <li>
                  <span aria-hidden="true">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <a href={entry.url} target="_blank" rel="noreferrer">
                    {entry.title} <span aria-hidden="true">↗</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </aside>
      </article>
    </section>

    <section class="writing-section" aria-labelledby="writing-heading">
      <header class="projects-section-heading writing-section-heading">
        <div>
          <h2 id="writing-heading">Writing</h2>
          <p>
            <a href={content.publication.url} target="_blank" rel="noreferrer"
              >Read all writing on {content.publication.name}
              <span aria-hidden="true">↗</span></a
            >
            <span>{content.publication.description}</span>
          </p>
        </div>
      </header>

      <ol class="writing-list">
        {
          content.writing.map((entry, index) => (
            <li>
              <a href={entry.url} target="_blank" rel="noreferrer">
                <span class="writing-index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="writing-copy">
                  <h3 class="writing-title">{entry.title}</h3>
                  <span class="writing-subtitle">{entry.subtitle}</span>
                </span>
                <time datetime={entry.date}>{formatDate(entry.date)}</time>
                <span class="writing-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>

  <footer class="work-index-footer">
    <p>&copy; 2026 KC Wolff-Ingham</p>
  </footer>
</BaseLayout>
