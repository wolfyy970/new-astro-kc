---
// ── The Editor's Note ─────────────────────────────────────────────────────────
// The introduction for every tier WITHOUT margins (<1420px), replacing two
// pieces of chrome that announced the system instead of demonstrating it: the
// black "widen to reveal marginalia" bar and the bordered "best on desktop"
// badge. Like the wide tier's cold-start margin note, this is a working scale
// model of the system, set where notes live at these tiers — bound into the
// top of the sheet as a printed editor's note: a rule, a mono label, and one
// sentence wearing a genuine yellow specimen stroke.
//
// The staged ladder is the same demonstration the margin intro performs:
// yellow specimen → the two-pens sentence → an example project gateway (the
// real control's classes) → the payoff line. The rule above narrates each
// stage in the pen on stage — yellow, then green, then back to the resting
// hairline once the reader has the whole ladder.
//
// Accessibility: the first sentence is real instructional content and is
// exposed. The staged extras are pointer theater — duplicative of what the
// genuinely accessible marked terms teach — so the reveal blocks are
// aria-hidden and nothing in the demonstration can take focus.
import { renderCaseStudyMarker } from "../utils/render";

const marker = renderCaseStudyMarker();
---

<aside
  id="edition-note"
  class="edition-note"
  aria-label="A note on this edition"
>
  <div class="edition-rule" aria-hidden="true"></div>
  <div class="edition-label">Interactive</div>
  <p class="edition-text">
    As you read, <span class="intro-term hs-mark-3"
      ><span class="hs-stroke">highlighted terms</span></span
    > hold detail, data, and media.<span class="edition-widen"
      >{" In a wider window, the notes keep to the margins."}</span
    >
  </p>
  <div class="intro-reveal intro-reveal--pens" aria-hidden="true">
    <div class="intro-reveal-inner">
      <p class="edition-text edition-text--pens">
        A yellow mark opens its note in the page; a <span
          class="intro-term intro-term--project hs-mark-6"
          ><span class="hs-stroke">green mark</span><Fragment
            set:html={marker}
          /></span
        > leads onward to a complete project.
      </p>
    </div>
  </div>
  <div class="intro-reveal intro-reveal--gateway" aria-hidden="true">
    <div class="intro-reveal-inner">
      <span class="popover-link intro-demo-link"
        ><span class="popover-link-label">View project</span></span
      >
    </div>
  </div>
  <div class="intro-reveal intro-reveal--done" aria-hidden="true">
    <div class="intro-reveal-inner">
      <div class="intro-done">You got it!</div>
    </div>
  </div>
</aside>

<script>
  import {
    CLS_INTRO_PENS,
    CLS_INTRO_GATEWAY,
    CLS_INTRO_DONE,
  } from "../scripts/constants.ts";
  import { attachIntroPayoff } from "../scripts/intro-payoff.ts";

  const note = document.getElementById("edition-note");
  if (note) {
    note
      .querySelector(".intro-term:not(.intro-term--project)")
      ?.addEventListener("click", () => note.classList.add(CLS_INTRO_PENS));
    note
      .querySelector(".intro-term--project")
      ?.addEventListener("click", () => note.classList.add(CLS_INTRO_GATEWAY));

    const link = note.querySelector<HTMLElement>(".intro-demo-link");
    const line = note.querySelector<HTMLElement>(".intro-done");
    if (link && line) {
      // First click unfolds the authored payoff; every click after that is
      // the payoff module's conversation, ending in the choreographed exit.
      attachIntroPayoff({
        root: note,
        link,
        line,
        doneClass: CLS_INTRO_DONE,
      });
    }
  }
</script>
