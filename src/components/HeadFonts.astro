---
// src/components/HeadFonts.astro
// Three families, one voice:
//   Newsreader   — display AND text (variable optical size + italic)
//   JetBrains Mono — annotation apparatus (labels, footnote markers, folios)
// Inter was dropped: it rendered no text on the résumé. UI chrome now uses the
// system UI stack, which costs no request.
---
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,200..600;1,6..72,200..500&display=swap"
  rel="stylesheet"
/>
