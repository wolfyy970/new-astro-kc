---
/**
 * StatRow — A horizontal band of large typographic outcome numbers.
 *
 * Numbers render at editorial scale; labels are small and uppercase.
 * Use to surface impact metrics as a scannable visual break between sections.
 */

interface StatItem {
    value: string;
    label: string;
}

interface Props {
    stats: StatItem[];
    label?: string;
    isDark?: boolean;
}

const { stats, label, isDark = false } = Astro.props;
---

<section class={`stat-row-section${isDark ? " is-dark" : ""}`}>
    <div class="stat-row-inner">
        {label && <p class="stat-row-label">{label}</p>}
        <div class="stat-grid">
            {stats.map(stat => (
                <div class="stat-item">
                    <span class="stat-value">{stat.value}</span>
                    <span class="stat-label">{stat.label}</span>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .stat-row-section {
        padding: var(--cs-pad-media);
        background: var(--doc-white, #fff);
        border-top: 1px solid var(--doc-rule);
        border-bottom: 1px solid var(--doc-rule);
    }

    .stat-row-section.is-dark {
        background: var(--case-study-dark, var(--cs-dark-bg));
        border-color: transparent;
    }

    .stat-row-inner {
        max-width: var(--cs-max-width-stat);
        margin: 0 auto;
    }

    .stat-row-label {
        font-family: var(--mono);
        font-size: var(--cs-eyebrow);
        font-weight: 500;
        letter-spacing: var(--cs-eyebrow-tracking);
        text-transform: uppercase;
        color: var(--label-color);
        margin-bottom: 48px;
        text-align: center;
    }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 40px 24px;
        text-align: center;
        border-right: 1px solid var(--doc-rule);
    }

    .stat-item:last-child {
        border-right: none;
    }

    

    .stat-value {
        font-family: var(--display);
        font-size: var(--cs-stat-value);
        font-weight: 400;
        line-height: 1;
        color: var(--stat-value-color);
        display: block;
    }

    .stat-label {
        display: block;
        margin-top: 16px;
        font-size: var(--cs-stat-label);
        font-weight: 500;
        letter-spacing: var(--type-label-spacing);
        text-transform: uppercase;
        color: var(--stat-label-color);
        line-height: 1.4;
        max-width: 160px;
    }

    @media (max-width: 768px) {
        .stat-row-section { padding: var(--cs-pad-media-tablet); }
        .stat-grid { grid-template-columns: repeat(2, 1fr); }
        .stat-item { border-right: none; border-bottom: 1px solid var(--doc-rule); }
        .stat-item:nth-child(odd) { border-right: 1px solid var(--doc-rule); }
        .stat-item:last-child { border-bottom: none; }
    }

    @media (max-width: 480px) {
        .stat-row-section { padding: var(--cs-pad-media-mobile); }
        .stat-grid { grid-template-columns: 1fr; }
        .stat-item { border-right: none; }
    }
</style>
