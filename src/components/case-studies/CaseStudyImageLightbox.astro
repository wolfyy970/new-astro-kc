<dialog
  class="case-study-image-lightbox"
  data-case-study-lightbox
  aria-label="Enlarged project image"
>
  <header class="lightbox-header">
    <div class="lightbox-heading">
      <p class="lightbox-caption" data-case-study-lightbox-caption></p>
      <p class="lightbox-hint">
        <span class="hint-fine"
          >Move over the image to magnify · click to turn off · +/− to zoom</span
        >
        <span class="hint-coarse"
          >Turn on Magnifier, then press and drag on the image</span
        >
      </p>
    </div>
    <div class="lightbox-controls">
      <div class="lightbox-zoom" role="group" aria-label="Magnifier zoom">
        <button
          class="lightbox-button"
          type="button"
          data-case-study-zoom-out
          aria-label="Zoom out"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"
            ><path d="M3.5 8h9"></path></svg
          >
        </button>
        <output class="lightbox-zoom-level" data-case-study-zoom-level
          >2.5×</output
        >
        <button
          class="lightbox-button"
          type="button"
          data-case-study-zoom-in
          aria-label="Zoom in"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"
            ><path d="M3.5 8h9M8 3.5v9"></path></svg
          >
        </button>
      </div>
      <button
        class="lightbox-button lightbox-toggle"
        type="button"
        data-case-study-magnifier-toggle
        aria-pressed="true"
      >
        Magnifier
      </button>
      <button
        class="lightbox-button lightbox-close"
        type="button"
        data-case-study-image-close
        aria-label="Close enlarged image"
      >
        Close
      </button>
    </div>
  </header>
  <div
    class="lightbox-stage"
    data-case-study-stage
    tabindex="0"
    role="group"
    aria-label="Image magnifier"
  >
    <figure class="lightbox-figure" data-case-study-figure>
      <img data-case-study-lightbox-image alt="" />
      <div class="lightbox-lens" data-case-study-lens aria-hidden="true"></div>
    </figure>
  </div>
  <p class="lightbox-live" aria-live="polite" data-case-study-live></p>
</dialog>

<script>
  import { initCaseStudyLightbox } from "../../scripts/case-study-lightbox";

  initCaseStudyLightbox();
</script>

<style>
  .case-study-image-lightbox {
    --lightbox-chrome: 148px;
    width: min(96vw, 1600px);
    max-width: 96vw;
    max-height: 94dvh;
    margin: auto; /* base.css zeroes every margin, which would pin the dialog top-left */
    padding: 0;
    border: 1px solid var(--doc-rule);
    background: var(--doc-white, #fff);
    color: var(--doc-heading, #111);
    overflow: hidden;
  }

  .case-study-image-lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  /* A tall page needs a definite height so the stage (not the dialog) scrolls. */
  .case-study-image-lightbox[data-orientation="tall"] {
    height: 94dvh;
  }

  .case-study-image-lightbox::backdrop {
    background: rgb(9 14 20 / 84%);
  }

  /* The header lives outside the image stage, so the lens (which is clipped to
     the image) can never sit on top of Close or the zoom controls. */
  .lightbox-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 10px 10px clamp(16px, 2.4vw, 28px);
    border-bottom: 1px solid var(--doc-rule);
    background: var(--doc-white, #fff);
  }

  .lightbox-heading {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .lightbox-caption {
    margin: 0;
    overflow: hidden;
    color: var(--doc-heading, #111);
    font-family: var(--doc-serif);
    font-size: var(--cs-caption);
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lightbox-hint {
    margin: 0;
    overflow: hidden;
    color: var(--doc-body, #555);
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hint-coarse {
    display: none;
  }

  /* Matches the lens default: touch gets the press-and-drag instructions. */
  .case-study-image-lightbox[data-pointer="touch"] .hint-fine {
    display: none;
  }

  .case-study-image-lightbox[data-pointer="touch"] .hint-coarse {
    display: inline;
  }

  .lightbox-live {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .lightbox-controls {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
  }

  .lightbox-zoom {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--doc-rule);
  }

  .lightbox-zoom .lightbox-button {
    min-width: 44px;
    border: 0;
  }

  .lightbox-zoom-level {
    display: inline-grid;
    min-width: 5ch;
    place-items: center;
    border-inline: 1px solid var(--doc-rule);
    color: var(--doc-heading, #111);
    font-family: var(--mono);
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .lightbox-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--doc-rule);
    background: var(--doc-white, #fff);
    color: var(--doc-heading, #111);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  .lightbox-button svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: square;
    stroke-width: 1.5;
  }

  .lightbox-button:hover {
    border-color: var(--accent);
  }

  .lightbox-button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  .lightbox-button[aria-disabled="true"] {
    color: var(--doc-body, #555);
    cursor: default;
    opacity: 0.4;
  }

  .lightbox-button[aria-disabled="true"]:hover {
    border-color: var(--doc-rule);
  }

  .lightbox-toggle[aria-pressed="true"] {
    border-color: var(--doc-heading, #111);
    background: var(--doc-heading, #111);
    color: var(--doc-white, #fff);
  }

  .lightbox-toggle[aria-pressed="true"]:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: #fff;
  }

  .lightbox-stage {
    display: grid;
    flex: 1 1 auto;
    min-height: 0;
    padding: clamp(12px, 2vw, 28px);
    overflow: auto;
    overscroll-behavior: contain;
    place-items: center;
  }

  .lightbox-stage:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }

  .lightbox-figure {
    position: relative;
    margin: 0;
    max-width: 100%;
    line-height: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  /* While the full-resolution file downloads, the inline display variant is
     painted as a stand-in in a box with the final proportions. */
  .lightbox-figure[data-loading="true"] {
    width: min(
      100%,
      var(--lightbox-natural-width, 100%),
      calc((94dvh - var(--lightbox-chrome)) * var(--lightbox-aspect, 1))
    );
    aspect-ratio: var(--lightbox-aspect, auto);
  }

  /* Regular images fit the stage on both axes. */
  .lightbox-figure img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: calc(94dvh - var(--lightbox-chrome));
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Tall captures fit the stage width and scroll, instead of shrinking to a
     sliver that can't be read. */
  .case-study-image-lightbox[data-orientation="tall"] .lightbox-stage {
    place-items: start center;
  }

  .case-study-image-lightbox[data-orientation="tall"] .lightbox-figure {
    width: min(100%, var(--lightbox-natural-width, 100%));
  }

  .case-study-image-lightbox[data-orientation="tall"] .lightbox-figure img {
    width: 100%;
    max-height: none;
  }

  .lightbox-stage[data-lens="on"] .lightbox-figure {
    cursor: crosshair;
  }

  .case-study-image-lightbox[data-pointer="touch"]
    .lightbox-stage[data-lens="on"]
    .lightbox-figure {
    touch-action: none;
  }

  .case-study-image-lightbox[data-orientation="tall"][data-pointer="touch"]
    .lightbox-stage[data-lens="on"]
    .lightbox-figure {
    touch-action: pan-y;
  }

  /* The glass: a square-cornered window onto the full-resolution file. */
  .lightbox-lens {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    overflow: hidden;
    border: 1px solid var(--doc-heading, #111);
    background-color: var(--doc-white, #fff);
    background-repeat: no-repeat;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 60%),
      0 14px 36px rgb(0 0 0 / 34%);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 120ms ease;
  }

  .lightbox-lens[data-visible="true"] {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-lens::after {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 4px 6px;
    background: var(--doc-heading, #111);
    color: var(--doc-white, #fff);
    content: attr(data-zoom);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-lens,
    .lightbox-button {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .case-study-image-lightbox {
      --lightbox-chrome: 190px;
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      border: 0;
    }

    .lightbox-header {
      flex-wrap: wrap;
      padding: 8px 8px 8px 16px;
    }

    .lightbox-heading {
      flex: 1 1 100%;
    }

    .lightbox-controls {
      flex: 1 1 100%;
      justify-content: space-between;
    }

    .lightbox-stage {
      padding: 12px;
    }
  }
</style>
