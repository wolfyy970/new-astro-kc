---
import { Image } from "astro:assets";
import type { CaseStudySectionData } from "../../types/content";
import { resolveDisplayImage } from "../../utils/display-image";
import CaseStudyImageTrigger from "./CaseStudyImageTrigger.astro";

type FullBleedSectionData = Extract<
  CaseStudySectionData,
  { type: "fullBleed" }
>;

interface Props {
  section: FullBleedSectionData;
}

const { section } = Astro.props;
// Inline view loads the display variant; the trigger keeps the full-res file.
const display = await resolveDisplayImage(section.image);
const size = display.size;
---

<section class="full-bleed">
  <CaseStudyImageTrigger
    src={section.image}
    alt={section.imageAlt}
    className="full-bleed-image-trigger"
  >
    <Image
      src={display.src}
      alt={section.imageAlt}
      width={size?.width ?? 1920}
      height={size?.height ?? 800}
      format="webp"
    />
  </CaseStudyImageTrigger>
</section>

<style>
  .full-bleed {
    height: 70vh;
    overflow: hidden;
  }

  .full-bleed img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .full-bleed-image-trigger {
    height: 100%;
  }
</style>
