---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  label?: string;
  title: string;
  description: string;
  isDark?: boolean;
}

const { label, title, description, isDark = false } = Astro.props;
---

<section class={`showcase-section${isDark ? " is-dark" : ""}`}>
  <div class="section-content">
    <SectionHeader
      {label}
      {title}
      description={description}
      bodyMaxWidth="measure"
    />

    <slot />
  </div>
</section>

<style>
  .showcase-section {
    padding: var(--cs-pad);
    background: var(--doc-white, #fff);
  }

  .showcase-section.is-dark {
    /* Pages can set --case-study-dark to override the computed dark bg */
    background: var(--case-study-dark, var(--cs-dark-bg));
    color: var(--doc-heading);
  }

  .section-content {
    max-width: var(--cs-max-width);
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .showcase-section {
      padding: var(--cs-pad-tablet);
    }
  }
</style>
