---
interface Props {
    label?: string;
    title: string;
    description: string;
    isDark?: boolean;
}

const { label, title, description, isDark = false } = Astro.props;
---

<section class={`showcase-section${isDark ? " is-dark" : ""}`}>
    <div class="section-content">
        {label && <div class="section-label">{label}</div>}
        <h2 class="section-heading">{title}</h2>
        <p class="section-body">{description}</p>

        <slot />
    </div>
</section>

<style>
    .showcase-section {
        padding: var(--cs-pad);
        background: var(--doc-white, #fff);
    }

    .showcase-section.is-dark {
        /* Pages can set --case-study-dark to override the computed dark bg */
        background: var(--case-study-dark, var(--cs-dark-bg));
        color: #fff;
    }

    .section-content {
        max-width: var(--cs-max-width);
        margin: 0 auto;
    }

    .section-label {
        font-size: var(--cs-eyebrow);
        font-weight: 600;
        letter-spacing: var(--cs-eyebrow-tracking);
        text-transform: uppercase;
        color: var(--label-color, var(--accent, currentColor));
        margin-bottom: 24px;
    }

    .section-heading {
        font-family: var(--display);
        font-size: var(--cs-heading);
        font-weight: 400;
        color: var(--text-primary, var(--doc-heading, #1a1a1a));
        line-height: 1.25;
        margin-bottom: 32px;
    }

    .is-dark .section-heading {
        color: #fff;
    }

    .section-body {
        font-family: var(--doc-sans);
        font-size: var(--cs-body);
        font-weight: 300;
        color: var(--text-secondary, var(--doc-body, #5a5a5a));
        line-height: 1.8;
        max-width: 800px;
    }

    .is-dark .section-body {
        color: rgba(255, 255, 255, 0.85);
    }

    @media (max-width: 1024px) {
        .showcase-section {
            padding: var(--cs-pad-tablet);
        }
    }
</style>
