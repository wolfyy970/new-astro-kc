---
import { Image } from "astro:assets";
import { publicImageSize } from "../../utils/image-size";

interface Props {
  title: string;
  subtitle: string;
  label?: string;
  image?: string;
  imageAlt?: string;
  background?: string;
  composition?: "immersive" | "product";
  brandMark?: string;
  brandMarkAlt?: string;
}

const {
  title,
  subtitle,
  label,
  image,
  imageAlt,
  background,
  composition = "immersive",
  brandMark,
  brandMarkAlt,
} = Astro.props;

// The product shot was declared 800x1200 whatever the file actually was.
const imageSize = image ? await publicImageSize(image) : null;
const bgSize = background ? await publicImageSize(background) : null;
---

<div
  class={`hero ${background ? "has-bg" : ""}`}
  data-composition={composition}
>
  {
    background && (
      <div class="hero-bg">
        <Image
          src={background}
          alt=""
          width={bgSize?.width ?? 1920}
          height={bgSize?.height ?? 1080}
          format="webp"
          quality="mid"
          loading="eager"
        />
      </div>
    )
  }
  <div class="hero-content">
    {
      label && composition !== "product" && (
        <div class="hero-label">{label}</div>
      )
    }
    <div class="hero-title-row">
      {
        brandMark && (
          <img
            class="hero-brand-mark"
            src={brandMark}
            alt={brandMarkAlt ?? ""}
            width="44"
            height="44"
            loading="eager"
            decoding="async"
          />
        )
      }
      <h1 class="hero-title">{title}</h1>
    </div>
    <p class="hero-subtitle">{subtitle}</p>
    {
      label && composition === "product" && (
        <div class="hero-label product-label">{label}</div>
      )
    }
  </div>
  {
    image && (
      <div class="hero-right">
        <Image
          src={image}
          alt={imageAlt || ""}
          width={imageSize?.width ?? 800}
          height={imageSize?.height ?? 1200}
          format="webp"
          quality="high"
          loading="eager"
        />
      </div>
    )
  }
</div>

<style>
  .hero {
    position: relative;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--accent) 60%, #000) 0%,
      var(--accent) 50%,
      color-mix(in srgb, var(--accent) 80%, #fff) 100%
    );
    overflow: hidden;
    padding: var(--cs-pad);
  }

  .hero.has-bg {
    background: none;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    /* Navy, and deliberately not derived from --accent. Only three pages
           use a hero photograph — Delta, Two Way TV and Felix — and all three
           are blue-field brands. Deriving this from the accent washed Delta's
           imagery red, when navy is Delta's own second colour. */
    background: rgba(11, 27, 43, 0.6);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 840px;
  }

  .hero-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 28px);
    margin-bottom: 40px;
  }

  /* When there's a standalone image (like Truist/Upwave) */
  .hero:not(.has-bg) .hero-content {
    margin-bottom: 80px;
  }

  .hero-right {
    z-index: 2;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  /* The product shot sits on the field, it does not hover over it. The 32px
       corner was a device bezel drawn around images that already have their
       own, and the 128px shadow was the page's largest object claiming to
       float — on a surface that scrolls with it. */
  .hero-right img {
    max-height: 520px;
    width: auto;
    height: auto;
    max-width: 100%;
    border-radius: var(--cs-radius);
    background: #000;
  }

  .hero-label {
    font-family: var(--mono);
    font-size: var(--cs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--cs-eyebrow-tracking);
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 32px;
  }

  .hero-title {
    font-family: var(--display);
    font-size: var(--cs-hero-title);
    font-weight: 400;
    color: #fff;
    line-height: 1.05;
    margin: 0;
  }

  /* White, and held back from the title by size alone.
       It was rgba(255,255,255,.85), then a color-mix toward the accent — both
       ways of making it dimmer than white. But the field is calibrated so that
       *white* clears 4.9:1; anything below white on it lands under AA (Upwave
       measured 4.32:1, Two Way TV 3.99:1). There is no tint that both reads as
       a step down and passes. It does not need one: 20px against an 80px title
       is already a 4× step, which is a stronger signal than a 15% tonal shift
       was ever making. */
  .hero-subtitle {
    font-size: var(--cs-hero-subtitle);
    font-weight: 400;
    color: #fff;
    line-height: 1.75;
    max-width: 640px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .hero {
      padding: 120px 32px;
    }
    .hero-content {
      margin-bottom: 48px !important;
    }
    .hero-right img {
      max-height: 480px;
    }
  }

  /* Org Chart Studio's own Sunny Peeps system is surface-led: neutral stock,
     near-black type, its official mark, and the product's real color doing the
     expressive work. Keep the portfolio's immersive accent field for studies
     whose source brand actually uses one. */
  .hero[data-composition="product"] {
    min-height: min(780px, calc(100svh - var(--site-nav-height)));
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(48px, 6vw, 96px);
    padding: clamp(72px, 8vw, 120px) clamp(32px, 6vw, 96px);
    background: var(--doc-white);
    color: var(--doc-heading);
    text-align: left;
    border-bottom: 1px solid var(--doc-rule);
  }

  .hero[data-composition="product"] .hero-content {
    max-width: 700px;
    margin: 0;
  }

  .hero[data-composition="product"] .hero-title-row {
    justify-content: flex-start;
    gap: 18px;
    margin-bottom: 28px;
  }

  .hero-brand-mark {
    display: block;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
  }

  .hero[data-composition="product"] .hero-title {
    color: var(--doc-heading);
    font-size: clamp(40px, 4.4vw, 64px);
    white-space: nowrap;
  }

  .hero[data-composition="product"] .hero-subtitle {
    max-width: 620px;
    margin: 0;
    color: var(--doc-body);
    line-height: 1.55;
  }

  .hero[data-composition="product"] .product-label {
    margin-top: 28px;
    margin-bottom: 0;
    color: var(--label-color);
    text-align: left;
  }

  .hero[data-composition="product"] .hero-right {
    justify-self: end;
    max-width: 900px;
  }

  .hero[data-composition="product"] .hero-right img {
    width: 100%;
    max-height: min(560px, 68vh);
    object-fit: contain;
    background: var(--doc-white);
    border: 1px solid var(--doc-rule);
  }

  @media (max-width: 1180px) {
    .hero[data-composition="product"] {
      min-height: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
      padding: var(--cs-pad-tablet);
    }

    .hero[data-composition="product"] .hero-content {
      margin: 0 !important;
    }

    .hero[data-composition="product"] .hero-right {
      justify-self: start;
      max-width: 840px;
    }
  }

  @media (max-width: 600px) {
    .hero[data-composition="product"] {
      gap: 32px;
      padding: 72px 24px 64px;
    }

    .hero[data-composition="product"] .hero-title {
      font-size: clamp(30px, 9vw, 36px);
    }

    .hero[data-composition="product"] .hero-title-row {
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 22px;
    }

    .hero[data-composition="product"] .hero-brand-mark {
      width: 32px;
      height: 32px;
      margin-top: 4px;
    }

    .hero[data-composition="product"] .hero-right img {
      max-height: none;
    }
  }

  @media (max-width: 380px) {
    .hero[data-composition="product"] .hero-title-row {
      flex-direction: column;
      gap: 14px;
    }

    .hero[data-composition="product"] .hero-brand-mark {
      margin-top: 0;
    }
  }
</style>
