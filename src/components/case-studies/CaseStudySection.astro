---
/**
 * Exhaustive section dispatcher. The discriminated union in content/schema.ts
 * owns every variant's required fields; this component only maps a validated
 * variant to its renderer and applies shared section theming.
 */
import type { CaseStudySectionData } from "../../types/content";
import { isHexColorDark } from "../../utils/color";
import CaptionedImage from "./CaptionedImage.astro";
import ExternalVideoSection from "./ExternalVideoSection.astro";
import FeatureRow from "./FeatureRow.astro";
import FullBleedSection from "./FullBleedSection.astro";
import LargeImageSection from "./LargeImageSection.astro";
import PhotoGrid from "./PhotoGrid.astro";
import ShowcaseCard from "./ShowcaseCard.astro";
import ShowcaseGrid from "./ShowcaseGrid.astro";
import ShowcaseSection from "./ShowcaseSection.astro";
import StatRow from "./StatRow.astro";
import VideoSection from "./VideoSection.astro";

type Props = CaseStudySectionData;
const section = Astro.props;

const wrapperParts: string[] = [];
if (section.bg) wrapperParts.push(`background: ${section.bg}`);
if (section.darkBg) {
  wrapperParts.push(`--case-study-dark: ${section.darkBg}`);
}
const wrapperStyle = wrapperParts.join("; ") || undefined;
const isSectionDark = Boolean(section.isDark) || isHexColorDark(section.bg);
const sectionClass = isSectionDark
  ? "section-dark"
  : section.bg
    ? "section-light"
    : undefined;
---

<div class={sectionClass} style={wrapperStyle}>
  {
    section.type === "cardGrid" && (
      <ShowcaseSection
        label={section.label}
        title={section.title ?? ""}
        description={section.description ?? ""}
        isDark={isSectionDark}
      >
        <ShowcaseGrid columns={section.columns ?? 2}>
          {section.cards.map((card) => (
            <ShowcaseCard {...card} isDark={isSectionDark} />
          ))}
        </ShowcaseGrid>
      </ShowcaseSection>
    )
  }

  {
    section.type === "mixedGrid" && (
      <ShowcaseSection
        label={section.label}
        title={section.title ?? ""}
        description={section.description ?? ""}
        isDark={isSectionDark}
      >
        <ShowcaseGrid columns={1}>
          <ShowcaseCard {...section.primaryCard} wide isDark={isSectionDark} />
        </ShowcaseGrid>
        <ShowcaseGrid columns={2}>
          {section.secondaryCards.map((card) => (
            <ShowcaseCard {...card} isDark={isSectionDark} />
          ))}
        </ShowcaseGrid>
      </ShowcaseSection>
    )
  }

  {
    section.type === "featureRow" && (
      <FeatureRow
        title={section.title}
        description={section.description}
        image={section.image}
        imageAlt={section.imageAlt}
        label={section.label}
        reverse={section.reverse}
        link={section.link}
        linkText={section.linkText}
        caption={section.caption}
      />
    )
  }

  {
    section.type === "textOnly" && (
      <ShowcaseSection
        label={section.label}
        title={section.title}
        description={section.description}
        isDark={isSectionDark}
      />
    )
  }

  {
    section.type === "largeImage" && (
      <LargeImageSection section={section} isDark={isSectionDark} />
    )
  }

  {section.type === "fullBleed" && <FullBleedSection section={section} />}

  {
    section.type === "captionedImage" && (
      <CaptionedImage
        image={section.image}
        imageAlt={section.imageAlt}
        caption={section.caption}
        label={section.label}
        isMobile={section.isMobile}
        displayWidth={section.displayWidth}
      />
    )
  }

  {
    section.type === "photoGrid" && (
      <PhotoGrid
        images={section.images}
        columns={section.columns ?? 2}
        label={section.label}
        title={section.title}
        description={section.description}
        gap={section.gap}
      />
    )
  }

  {
    section.type === "statRow" && (
      <StatRow
        stats={section.stats}
        label={section.label}
        isDark={isSectionDark}
      />
    )
  }

  {
    section.type === "video" && (
      <VideoSection section={section} isDark={isSectionDark} />
    )
  }

  {
    section.type === "externalVideo" && (
      <ExternalVideoSection section={section} isDark={isSectionDark} />
    )
  }
</div>
