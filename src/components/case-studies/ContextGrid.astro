---
interface Props {
    challenge: string;
    role: string;
    company: string;
    scope: string;
    team: string;
}

const { challenge, role, company, scope, team } = Astro.props;
---

<section class="context">
    <div class="context-inner">
        <div>
            <div class="section-label">The Challenge</div>
            <h2 class="section-heading">{challenge}</h2>
            <p class="section-body">
                <slot />
            </p>
        </div>
        <div>
            <div class="meta-grid">
                <div class="meta-item">
                    <h3>My Role</h3>
                    <p>{role}</p>
                </div>
                <div class="meta-item">
                    <h3>Company</h3>
                    <p>{company}</p>
                </div>
                <div class="meta-item">
                    <h3>Scope</h3>
                    <p>{scope}</p>
                </div>
                <div class="meta-item">
                    <h3>Team</h3>
                    <p>{team}</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .context {
        padding: var(--cs-pad);
        background: var(--doc-white, #fff);
    }

    .context-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        max-width: var(--cs-max-width);
        margin: 0 auto;
    }

    .section-label {
        font-family: var(--mono);
        font-size: var(--cs-eyebrow);
        font-weight: 500;
        letter-spacing: var(--cs-eyebrow-tracking);
        text-transform: uppercase;
        color: var(--label-color);
        margin-bottom: 24px;
    }

    .section-heading {
        font-family: var(--display);
        font-size: var(--cs-heading);
        font-weight: 400;
        color: var(--text-primary);
        line-height: 1.25;
        margin-bottom: 32px;
    }

    .section-body {
        font-family: var(--doc-serif);
        font-size: var(--cs-body);
        font-weight: 400;
        color: var(--text-secondary);
        line-height: 1.8;
    }

    .meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 48px;
    }

    .meta-item p {
        font-size: var(--cs-card-body);
        font-weight: 400;
        color: var(--text-primary);
        line-height: 1.4;
    }

    @media (max-width: 1024px) {
        .context {
            padding: var(--cs-pad-tablet);
        }
        .context-inner {
            grid-template-columns: 1fr;
            gap: 48px;
        }
        .meta-grid {
            gap: 32px;
        }
    }
</style>
