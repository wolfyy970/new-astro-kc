---
import { Image } from "astro:assets";
import { publicImageSize } from "../../utils/image-size";

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  label?: string;
  reverse?: boolean;
  link?: string;
  linkText?: string;
  caption?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  label,
  reverse = false,
  link,
  linkText,
  caption,
} = Astro.props;

// Real dimensions, so the reserved box matches the picture.
const size = (await publicImageSize(image)) ?? { width: 800, height: 600 };
---

<section class={`feature-row${reverse ? " reverse" : ""}`}>
  <div class="feature-image">
    <Image
      src={image}
      alt={imageAlt}
      width={size.width}
      height={size.height}
      format="webp"
      quality="mid"
    />
    {caption && <p class="feature-image-caption">{caption}</p>}
  </div>
  <div class="feature-text">
    {label && <div class="section-label">{label}</div>}
    <h2 class="section-heading">{title}</h2>
    <p class="section-body">{description}</p>
    {
      link && linkText && (
        <a class="feature-link" href={link}>
          <span>{linkText}</span>
          <span class="feature-link-arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
    <slot />
  </div>
</section>

<style>
  .feature-row {
    display: flex;
    align-items: center;
    gap: 80px;
    padding: var(--cs-pad);
    background: var(--doc-white, #fff);
    max-width: var(--cs-max-width);
    margin: 0 auto;
  }

  .feature-row.reverse {
    flex-direction: row-reverse;
  }

  .feature-image {
    flex: 1;
  }

  /* height: auto is not optional. The image tag carries width/height attributes,
       and with only `width: 100%` set the attribute height stays in force — so
       the picture is drawn at container-width x attribute-height and squashed
       to whatever ratio the component happened to hardcode. Releasing the
       height lets the browser use the file's real proportions. */
  .feature-image img {
    width: 100%;
    height: auto;
    border-radius: var(--cs-radius);
    border: 1px solid var(--doc-rule);
  }

  :global(.feature-image-caption) {
    margin-top: 20px;
    max-width: 680px;
    color: var(--text-secondary, #666);
    font-family: var(--doc-serif);
    font-size: var(--cs-caption);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
  }

  .feature-text {
    flex: 1;
  }

  .section-label {
    font-family: var(--mono);
    font-size: var(--cs-eyebrow);
    font-weight: 500;
    letter-spacing: var(--cs-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--label-color);
    margin-bottom: 24px;
  }

  .section-heading {
    font-family: var(--display);
    font-size: var(--cs-heading);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.25;
    margin-bottom: 32px;
  }

  .section-body {
    font-family: var(--doc-serif);
    font-size: var(--cs-body);
    font-weight: 400;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  /* Astro does not statically see the optional CTA branch when pruning
       scoped selectors. Keep this component-owned class global so the
       conditional link receives its intended treatment when rendered. */
  :global(.feature-link) {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    margin-top: 32px;
    padding: 10px 10px 10px 14px;
    min-width: min(100%, 300px);
    border: 1px solid var(--doc-rule);
    background: color-mix(in srgb, var(--text-primary) 4%, var(--doc-white));
    font-family: var(--mono);
    font-size: var(--cs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--cs-eyebrow-tracking);
    text-transform: uppercase;
    color: var(--text-primary);
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  :global(.feature-link-arrow) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    background: var(--text-primary);
    color: var(--doc-white);
    letter-spacing: 0;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.feature-link:hover) {
    border-color: var(--text-primary);
    background: color-mix(in srgb, var(--text-primary) 7%, var(--doc-white));
  }

  :global(.feature-link:hover .feature-link-arrow),
  :global(.feature-link:focus-visible .feature-link-arrow) {
    transform: translateX(3px);
  }

  :global(.feature-link:focus-visible) {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  @media (max-width: 1024px) {
    .feature-row {
      flex-direction: column !important;
      padding: var(--cs-pad-tablet);
      gap: 48px;
    }

    /* On a single-column layout, introduce the work before presenting it.
           Leaving the desktop image-first DOM order intact made an image at the
           top of a section look like an unexplained continuation of the section
           above it. */
    .feature-text {
      order: 1;
    }

    .feature-image {
      order: 2;
    }
  }
</style>
