---
import { Image } from "astro:assets";
import ProjectGateway from "../ProjectGateway.astro";
import SectionHeader from "./SectionHeader.astro";
import { publicImageSize } from "../../utils/image-size";

interface Props {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  label?: string;
  reverse?: boolean;
  link?: string;
  linkText?: string;
  caption?: string;
}

const {
  title,
  description,
  image,
  imageAlt,
  label,
  reverse = false,
  link,
  linkText,
  caption,
} = Astro.props;

// Real dimensions, so the reserved box matches the picture.
const size = (await publicImageSize(image)) ?? { width: 800, height: 600 };
---

<section class={`feature-row${reverse ? " reverse" : ""}`}>
  <div class="feature-image">
    <Image
      src={image}
      alt={imageAlt}
      width={size.width}
      height={size.height}
      format="webp"
      quality="mid"
    />
    {caption && <p class="feature-image-caption">{caption}</p>}
  </div>
  <div class="feature-text">
    <SectionHeader {label} {title} description={description} />
    {link && linkText && <ProjectGateway href={link} label={linkText} />}
    <slot />
  </div>
</section>

<style>
  .feature-row {
    display: flex;
    align-items: center;
    gap: 80px;
    padding: var(--cs-pad);
    background: var(--doc-white, #fff);
    max-width: var(--cs-max-width);
    margin: 0 auto;
  }

  .feature-row.reverse {
    flex-direction: row-reverse;
  }

  .feature-image {
    flex: 1;
  }

  /* height: auto is not optional. The image tag carries width/height attributes,
       and with only `width: 100%` set the attribute height stays in force — so
       the picture is drawn at container-width x attribute-height and squashed
       to whatever ratio the component happened to hardcode. Releasing the
       height lets the browser use the file's real proportions. */
  .feature-image img {
    width: 100%;
    height: auto;
    border-radius: var(--cs-radius);
    border: 1px solid var(--doc-rule);
  }

  :global(.feature-image-caption) {
    margin-top: 20px;
    max-width: 680px;
    color: var(--doc-body, #666);
    font-family: var(--doc-serif);
    font-size: var(--cs-caption);
    font-style: italic;
    font-weight: 400;
    line-height: 1.5;
  }

  .feature-text {
    flex: 1;
  }

  @media (max-width: 1024px) {
    .feature-row {
      flex-direction: column !important;
      padding: var(--cs-pad-tablet);
      gap: 48px;
    }

    /* On a single-column layout, introduce the work before presenting it.
           Leaving the desktop image-first DOM order intact made an image at the
           top of a section look like an unexplained continuation of the section
           above it. */
    .feature-text {
      order: 1;
    }

    .feature-image {
      order: 2;
    }
  }
</style>
