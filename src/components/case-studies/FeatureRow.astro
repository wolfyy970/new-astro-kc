---
import { Image } from "astro:assets";
import { publicImageSize } from "../../utils/image-size";

interface Props {
    title: string;
    description: string;
    image: string;
    imageAlt: string;
    label?: string;
    reverse?: boolean;
}

const {
    title,
    description,
    image,
    imageAlt,
    label,
    reverse = false,
} = Astro.props;

// Real dimensions, so the reserved box matches the picture.
const size = (await publicImageSize(image)) ?? { width: 800, height: 600 };
---

<section class={`feature-row${reverse ? " reverse" : ""}`}>
    <div class="feature-image">
        <Image
            src={image}
            alt={imageAlt}
            width={size.width}
            height={size.height}
            format="webp"
            quality="mid"
        />
    </div>
    <div class="feature-text">
        {label && <div class="section-label">{label}</div>}
        <h2 class="section-heading">{title}</h2>
        <p class="section-body">{description}</p>
        <slot />
    </div>
</section>

<style>
    .feature-row {
        display: flex;
        align-items: center;
        gap: 80px;
        padding: var(--cs-pad);
        background: var(--doc-white, #fff);
        max-width: var(--cs-max-width);
        margin: 0 auto;
    }

    .feature-row.reverse {
        flex-direction: row-reverse;
    }

    .feature-image {
        flex: 1;
    }

    /* height: auto is not optional. The image tag carries width/height attributes,
       and with only `width: 100%` set the attribute height stays in force — so
       the picture is drawn at container-width x attribute-height and squashed
       to whatever ratio the component happened to hardcode. Releasing the
       height lets the browser use the file's real proportions. */
    .feature-image img {
        width: 100%;
        height: auto;
        border-radius: var(--cs-radius);
        border: 1px solid var(--doc-rule);
    }

    .feature-text {
        flex: 1;
    }

    .section-label {
        font-family: var(--mono);
        font-size: var(--cs-eyebrow);
        font-weight: 500;
        letter-spacing: var(--cs-eyebrow-tracking);
        text-transform: uppercase;
        color: var(--label-color);
        margin-bottom: 24px;
    }

    .section-heading {
        font-family: var(--display);
        font-size: var(--cs-heading);
        font-weight: 400;
        color: var(--text-primary);
        line-height: 1.25;
        margin-bottom: 32px;
    }

    .section-body {
        font-family: var(--doc-serif);
        font-size: var(--cs-body);
        font-weight: 400;
        color: var(--text-secondary);
        line-height: 1.8;
    }

    @media (max-width: 1024px) {
        .feature-row {
            flex-direction: column !important;
            padding: var(--cs-pad-tablet);
            gap: 48px;
        }
    }
</style>
