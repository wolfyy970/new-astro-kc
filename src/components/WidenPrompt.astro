---
import Icon from "./Icon.astro";
import { BREAKPOINT_MOBILE, BREAKPOINT_WIDE } from "../scripts/constants";
---

<aside
  id="widen-prompt"
  class="widen-prompt"
  role="status"
  aria-live="polite"
  aria-hidden="true"
>
  <Icon name="arrows-horizontal" size={18} />
  <span class="widen-prompt-copy">
    <span class="widen-prompt-label" aria-hidden="true"
      >Widen to reveal marginalia</span
    >
    <span class="widen-prompt-ready" aria-hidden="true"
      >Marginalia revealed</span
    >
  </span>
  <span class="widen-prompt-progress" aria-hidden="true">
    <span class="widen-prompt-progress-fill"></span>
  </span>
  <span class="sr-only widen-prompt-status">Widen to reveal marginalia</span>
</aside>

<style>
  .widen-prompt {
    --widen-progress: 0;
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    max-width: calc(100% - 48px);
    max-height: 0;
    margin: 0 auto;
    padding: 0 14px;
    overflow: hidden;
    color: var(--doc-white);
    background: var(--doc-heading);
    border: 1px solid transparent;
    border-radius: 2px;
    opacity: 0;
    pointer-events: none;
    transition:
      color 180ms ease,
      background-color 180ms ease,
      border-color 180ms ease,
      opacity 220ms ease,
      max-height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      margin 280ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .widen-prompt.is-visible {
    max-height: 48px;
    margin-top: 18px;
    padding: 10px 14px;
    border-color: var(--doc-heading);
    opacity: 1;
  }

  .widen-prompt.is-ready {
    color: var(--doc-heading);
    background: var(--doc-white);
    border-color: var(--doc-rule);
  }

  .widen-prompt.is-complete {
    max-height: 0;
    margin-top: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-color: transparent;
    opacity: 0;
  }

  .widen-prompt-copy {
    display: grid;
  }

  .widen-prompt-label,
  .widen-prompt-ready {
    grid-area: 1 / 1;
    font-family: var(--mono);
    font-size: var(--type-meta);
    font-weight: 500;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
    transition: opacity 180ms ease;
  }

  .widen-prompt-ready {
    opacity: 0;
  }

  .is-ready .widen-prompt-label {
    opacity: 0;
  }

  .is-ready .widen-prompt-ready {
    opacity: 1;
  }

  .widen-prompt-progress {
    width: 56px;
    height: 1px;
    overflow: hidden;
    background: var(--doc-rule);
  }

  .widen-prompt-progress-fill {
    display: block;
    width: calc(var(--widen-progress) * 100%);
    height: 100%;
    background: currentColor;
  }

  .is-ready .widen-prompt-progress {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .widen-prompt {
      transition: none;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    visibleMin: BREAKPOINT_MOBILE,
    threshold: BREAKPOINT_WIDE,
  }}
>
  const prompt = document.getElementById("widen-prompt");
  const status = prompt?.querySelector(".widen-prompt-status");
  const readyBeatMs = 1400;

  if (prompt) {
    let armed = false;
    let showingReady = false;
    let readyTimer = 0;
    let frame = 0;

    const setHidden = (hidden) => {
      prompt.setAttribute("aria-hidden", String(hidden));
    };

    const render = () => {
      frame = 0;
      const width = window.innerWidth;
      const progress = Math.max(
        0,
        Math.min(1, (width - visibleMin) / (threshold - visibleMin)),
      );
      prompt.style.setProperty("--widen-progress", String(progress));

      if (width >= threshold) {
        if (showingReady) return;

        if (armed) {
          armed = false;
          showingReady = true;
          if (status) status.textContent = "Marginalia revealed";
          prompt.classList.remove("is-complete");
          prompt.classList.add("is-visible", "is-ready");
          setHidden(false);
          window.clearTimeout(readyTimer);
          readyTimer = window.setTimeout(() => {
            showingReady = false;
            prompt.classList.add("is-complete");
            setHidden(true);
          }, readyBeatMs);
          return;
        }

        prompt.classList.add("is-complete");
        prompt.classList.remove("is-visible", "is-ready");
        setHidden(true);
        return;
      }

      window.clearTimeout(readyTimer);
      showingReady = false;

      if (width >= visibleMin) {
        armed = true;
        if (status) status.textContent = "Widen to reveal marginalia";
        prompt.classList.remove("is-complete", "is-ready");
        prompt.classList.add("is-visible");
        setHidden(false);
        return;
      }

      armed = false;
      prompt.classList.remove("is-visible", "is-complete", "is-ready");
      setHidden(true);
    };

    const scheduleRender = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(render);
    };

    scheduleRender();
    window.addEventListener("resize", scheduleRender);
  }
</script>
