---
import BaseHead from "../components/BaseHead.astro";
import SiteNav from "../components/SiteNav.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navSection?: "resume" | "work" | "projects" | "references";
}
const {
  title,
  description = "KC Wolff-Ingham, Design Leadership",
  ogImage,
  navSection,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <SiteNav current={navSection} />
    <slot />
  </body>
</html>
