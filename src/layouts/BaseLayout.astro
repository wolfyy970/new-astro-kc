---
import BaseHead from "../components/BaseHead.astro";
import ThemeToggleButton from "../components/ThemeToggleButton.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}
const {
  title,
  description = "KC Wolff-Ingham, Design Leadership",
  ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body>
    <ThemeToggleButton />
    <slot />
  </body>
</html>
