---
import "../styles/case-study.css";
import { buildAccentStyle } from "../utils/color";
import BaseHead from "../components/BaseHead.astro";
import ThemeToggleButton from "../components/ThemeToggleButton.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Brand accent color as a 6-digit hex (e.g. `"#3b1a5a"`). Falls back to the
   *  portfolio's neutral ink if omitted or invalid. */
  accent?: string;
}

const { title, description, ogImage, accent } = Astro.props;
const accentStyle = buildAccentStyle(accent);
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} />
  </head>
  <body style={accentStyle}>
    <ThemeToggleButton />
    <nav class="back-nav" aria-label="Case study navigation">
      <a
        class="back-link"
        href="/"
        aria-label="Back to resume"
        data-resume-back
      >
        <span aria-hidden="true">&larr;</span> Back
      </a>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <p>KC &mdash; Design Leadership</p>
    </footer>

    <script>
      import { initCaseStudyBackNavigation } from "../scripts/return-to-resume.ts";

      initCaseStudyBackNavigation();
    </script>
  </body>
</html>
