---
import "../styles/global.css";
import "../styles/case-study.css";
import { buildAccentStyle } from "../utils/color";
import ThemeScript from "../components/ThemeScript.astro";
import ThemeToggleButton from "../components/ThemeToggleButton.astro";
import HeadFonts from "../components/HeadFonts.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Brand accent color as a 6-digit hex (e.g. `"#3b1a5a"`). Falls back to the
   *  portfolio's default amber if omitted or invalid. */
  accent?: string;
}

const { title, description, ogImage, accent } = Astro.props;
const accentStyle = buildAccentStyle(accent);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.png" />

    <HeadFonts />
    <ThemeScript />
  </head>
  <body style={accentStyle}>
    <ThemeToggleButton />
    <nav class="back-nav" aria-label="Primary">
      <a class="back-link" href="/" aria-label="Back to resume">
        <span aria-hidden="true">&larr;</span> Back
      </a>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <p>KC &mdash; Design Leadership</p>
    </footer>
  </body>
</html>
